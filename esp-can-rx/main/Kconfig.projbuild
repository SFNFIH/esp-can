menu "ESP-CAN-RX Configuration"

    config EXAMPLE_ESPNOW_CHANNEL
        int "ESP-NOW Wi-Fi channel"
        range 1 13
        default 1
        help
            Must match esp-can-tx SoftAP / ESP-NOW channel.

    config EXAMPLE_ESPNOW_PEER_MAC
        string "Default TX peer MAC (optional)"
        default "00:00:00:00:00:00"
        help
            If set to a non-zero MAC, CLI can send without waiting to learn peer.
            You can also set it at runtime: peer AA:BB:CC:DD:EE:FF

endmenu
