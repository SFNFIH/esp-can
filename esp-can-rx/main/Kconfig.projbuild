menu "ESP-CAN-RX Configuration"

    config EXAMPLE_ESPNOW_CHANNEL
        int "ESP-NOW Wi-Fi channel"
        range 1 13
        default 1
        help
            Must match esp-can-tx.

    config EXAMPLE_LOG_EVERY_N_FRAMES
        int "Log every N received frames (0 = every frame)"
        range 0 10000
        default 1
        help
            Reduce UART spam when the vehicle bus is busy.

endmenu
